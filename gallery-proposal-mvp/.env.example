# Note: App now runs with in-memory mock data (no database required!)
# Database URL is NOT needed - the app uses mock data by default
# DATABASE_URL="postgresql://user:password@localhost:5432/gallery_crm?schema=public"

# Session secret (generate with: openssl rand -base64 32)
SESSION_SECRET="your-secret-key-here-generate-with-openssl"

# Anthropic API Key for LLM chat (OPTIONAL - chat won't work without it)
ANTHROPIC_API_KEY="sk-ant-api03-..."
